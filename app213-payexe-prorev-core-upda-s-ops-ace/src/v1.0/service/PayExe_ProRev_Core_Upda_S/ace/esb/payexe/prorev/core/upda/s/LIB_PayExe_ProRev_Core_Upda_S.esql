BROKER SCHEMA ace.esb.payexe.prorev.core.upda.s
PATH ace.esb.core.common; 


CREATE PROCEDURE armaMensajeTo_AS400_From_UpdatePaymentExecutionProcedureReverseCore(IN refEnv REFERENCE, IN refIn REFERENCE,IN refLocalEnv REFERENCE, IN refOutput REFERENCE, IN refOutLocal REFERENCE)
BEGIN
	SET refEnv.Srv.Destino = C_DESTINO_MAIN;
	SET refEnv.TramaIn.JSON = refIn.JSON;
	SET refEnv.StatusResp.exception = FALSE;
	SET refEnv.Temp.Variable.IsErrorValidCampo = FALSE;
	SET refEnv.Variables.NamePcml = C_NOMBRE_PCML;
	SET refEnv.Variables.TypeLibrary = getTYPE_LIBRARY_NOT_ATM();
	SET refEnv.Variables.Backend.TargetId = getCODE_APP_BUS();
	SET refEnv.Variables.Backend.OriginId = getCODE_APP_BUS();

	-- Eliminar RequestSchema
	DELETE FIELD refOutput.JSON.Data;

	CREATE LASTCHILD OF refEnv.Temp IDENTITY(JSON.Array)SrvErrors;
	CALL armaCuerpo_AS400(refEnv, refIn, refLocalEnv, refOutput, refOutLocal);
END;

CREATE PROCEDURE prepareDataRequestDFDL(IN refIn REFERENCE, IN refEnv REFERENCE, IN refService REFERENCE)
BEGIN
	CREATE LASTCHILD OF refEnv DOMAIN getDOMINIO_DFDL();
	CREATE FIELD refEnv.DFDL.RE0058RI.RE0058RIREQ AS refEnv;

	DECLARE refBodyIn REFERENCE TO refIn.JSON.Data.[<];
	DECLARE refBodyOut REFERENCE TO refEnv;

	SET refBodyOut.VIDTRA		= refIn.HTTPInputHeader."Bif-Correlation-Id";
	SET refBodyOut.VCANAL	  	= refIn.HTTPInputHeader."Bif-Consumer-Id";
	SET refBodyOut.VSERVIC	 	= refBodyIn.ServiceType;
	SET refBodyOut.INR02TOPE	= refService."CT-001"; 
	SET refBodyOut.INR02USID	= refService."CT-002"; 
	SET refBodyOut.INR02FACC	= refService."CT-003"; 
	SET refBodyOut.INR02CNL		= refBodyIn.ChannelIdentification;
	SET refBodyOut.INR02FPAG	= refBodyIn.PaymentMethod;
	SET refBodyOut.INR02TREC  	= refBodyIn.OrganisationType;	
	SET refBodyOut.INR02RECA	= refBodyIn.PartyRoleReference;
	SET refBodyOut.INR02TRX	  	= refBodyIn.TransactionReference;
	SET refBodyOut.INR02FECH  	= refBodyIn.TransactionDate;
	SET refBodyOut.INR02UAPR	= refBodyIn.MemberIdentification;
	SET refBodyOut.INR02TDR	    = refService."CT-004"; 
	SET refBodyOut.INR02NDOC	= refBodyIn.OrganisationIdentification;
	SET refBodyOut.INR02NSUM  	= refBodyIn.CollectionServiceConsumerReference;		
	SET refBodyOut.INR02MONE	= refBodyIn.Currency;
	SET refBodyOut.INR02CONV	= refBodyIn.AgreementIdentification;
	SET refBodyOut.IOR02IDCON  	= refBodyIn.InquiryReference;
	SET refBodyOut.IOR02IDPAG	= refBodyIn.PaymentInstrumentNumber;
	SET refBodyOut.IOR02IDOFI	= refBodyIn.BranchLocationReference;
	SET refBodyOut.INR02IDTRX  	= refBodyIn.TransactionIdentification;
	SET refBodyOut.INR02CAJE	= refBodyIn.OperationCashier;
	SET refBodyOut.INR02NPAG	= refBodyIn.NumberOfPage;
	SET refBodyOut.INR02CPAG  	= refBodyIn.TotalNumberOfRecords;
	SET refBodyOut.IOR02TOTRE  	= refBodyIn.TotalNumberOfRecords;
	SET refBodyOut.IOR02NROPA  	= refBodyIn.NumberOfPage;
	SET refBodyOut.INR03NRRE	= refBodyIn.PersonIdentification;
	SET refBodyOut.INR03REMO	= refBodyIn.Currency;
	SET refBodyOut.INR03FEMI	= refBodyIn.ExpiryDate;
	SET refBodyOut.INR03FVEN	= refBodyIn.ExpiryDate;
	
	DECLARE inputDueAmo DECIMAL refBodyIn.DueAmount;
	DECLARE DueAmount CHARACTER;
	SET refBodyOut.INR03MONT  = FormatLoanAmount(inputDueAmo,13,2);
	
	DECLARE inputLoaAmo DECIMAL refBodyIn.LoanAmount;
	DECLARE LoanAmount CHARACTER;
	SET refBodyOut.INR03MRED  = FormatLoanAmount(inputLoaAmo,13,2);

	DECLARE inputAmo DECIMAL refBodyIn.Amount;
	DECLARE Amount CHARACTER;
	SET refBodyOut.INR03MTOT  = FormatLoanAmount(inputAmo,13,2);
		
	SET refBodyOut.INR03TOTRE  	= refBodyIn.TotalNumberOfRecords;
	SET refBodyOut.INR03NROPA  	= refBodyIn.NumberOfPage;
	SET refBodyOut.INR04NOMB  	= refBodyIn.FullName;
	SET refBodyOut.INR04APPAT  	= refBodyIn.FullName;
	SET refBodyOut.INR04APMAT  	= refBodyIn.FullName;
	SET refBodyOut.INR05CANT	= refBodyIn.NumberOfPayments;
	SET refBodyOut.INR05AGRP  	= refBodyIn.IndustryClassification;
	SET refBodyOut.INR05TIPAG  	= refService."CT-027"; 
	SET refBodyOut.INR05IMPAG  	= FormatLoanAmount(inputAmo,13,2);
	SET refBodyOut.INR05MPAG  	= refBodyIn.DestinationAccountNumber;	
END;


CREATE PROCEDURE armaCuerpo_AS400(IN refEnv REFERENCE, IN refIn REFERENCE, IN refLocalEnv REFERENCE, IN refOutput REFERENCE, IN refOutLocal REFERENCE)
BEGIN
	DECLARE refService REFERENCE TO refEnv.Policy.service;
	DECLARE refBodyIn REFERENCE TO refIn.JSON.Data;

	CALL validarMensaje(refEnv, refIn, refService);
	CALL prepareDataRequestDFDL(refIn, refEnv, refService);
	CALL StructureReqDFDL(refEnv);

	SET refEnv.Variables.Invoke_cc = TRUE;
	CALL prepareCallToCentralizedBackend(refEnv, refOutput, refOutLocal, refService, refEnv.Srv.Destino);
	
	CREATE LASTCHILD OF refOutput DOMAIN getDOMINIO_JSON();
	CREATE LASTCHILD OF refOutput.JSON NAME getDATA();
	DECLARE refJsonOut REFERENCE TO refOutput.JSON.Data;
	DECLARE refPCML REFERENCE TO refEnv.Variables.CopyLengths.{C_NOMBRE_PCML};

	SET refJsonOut.CentralizedConnector.NamePcml = C_NOMBRE_PCML;
	SET refJsonOut.CentralizedConnector.Message = convertDfdlToChar(refIn, refOutput, refEnv, C_NOMBRE_PCML);
	SET refJsonOut.CentralizedConnector.LengthOut = CAST(refPCML.RSP AS CHARACTER);
	SET refJsonOut.CentralizedConnector.LengthErr = CAST(refPCML.ERR AS CHARACTER);

	CALL setConfAuditBackend(refEnv, refOutput, refOutLocal, getCONST_REST());
END;


CREATE PROCEDURE validarMensaje(IN refEnv REFERENCE, IN refIn REFERENCE, IN refService REFERENCE)
BEGIN
	DECLARE refBodyIn REFERENCE TO refIn.JSON.Data.[<];
	DECLARE decDueAmount    DECIMAL refBodyIn.DueAmount;
	DECLARE decLoanAmount   DECIMAL refBodyIn.LoanAmount;
	DECLARE decAmount    	DECIMAL refBodyIn.Amount;
	
	IF refService.cod_servicio <> refBodyIn.ServiceType THEN
		CALL setErrorCampo(C_ERROR_MSG_BDY_SERVICE_CODE, refEnv);
	END IF;

	IF ValidateDecimalFormat(decDueAmount,13,2) = FALSE THEN 
	    CALL setErrorCampo(C_ERROR_MSG_DECIMALES_DUE_AMOUNT, refEnv);
	END IF;

	IF ValidateDecimalFormat(decLoanAmount,13,2) = FALSE THEN 
	    CALL setErrorCampo(C_ERROR_MSG_DECIMALES_LOAN_AMOUNT, refEnv);
	END IF;
	
	IF ValidateDecimalFormat(decAmount,13,2) = FALSE THEN 
	    CALL setErrorCampo(C_ERROR_MSG_DECIMALES_AMOUNT, refEnv);
	END IF;	
END;


CREATE PROCEDURE armaRptaUpdatePaymentExecutionProcedureReverseCore_OK(IN refEnv REFERENCE, IN refIn REFERENCE, IN refOut REFERENCE)
BEGIN
	CALL PrepareRespPropertiesStatus(refEnv,refIn,refOut);
	
	CREATE LASTCHILD OF refOut DOMAIN getHTTP_RES_H();
	CREATE LASTCHILD OF refOut DOMAIN getDOMINIO_JSON();
	CREATE LASTCHILD OF refOut.JSON NAME getDATA();
	CREATE LASTCHILD OF refOut.JSON.Data NAME C_OPERATION_RS;

	DECLARE refHttpResOut REFERENCE TO refOut.HTTPResponseHeader;
	DECLARE refJsonOut REFERENCE TO refOut.JSON.Data.[<];
	DECLARE refDfdlOut REFERENCE TO refEnv.DFDLOut.DFDL.{C_NOMBRE_PCML}.{C_NOMBRE_PCML || 'RSP'};
	DECLARE refDfdlOutErr REFERENCE TO refEnv.DFDLOut.DFDL.{C_NOMBRE_PCML}.ELEERR;
	
	SET refJsonOut.ResultCode 				= refDfdlOutErr.PERROR;
	SET refJsonOut.ResultMessage 			= refDfdlOutErr.PEMNSG;	
	SET refJsonOut.TotalNumberOfRecords 	= CAST(refDfdlOut.OUR02TOTRE AS INTEGER);
	SET refJsonOut.TransactionReference 	= refDfdlOut.OUR02TRX;
	
	CALL prepararHeaderRespuestaBus_V2(refHttpResOut, refEnv);
END;


CREATE PROCEDURE armaRptaUpdatePaymentExecutionProcedureReverseCore_ERROR(IN refEnv REFERENCE, IN refIn REFERENCE, IN refOut REFERENCE, IN statusCode CHARACTER)
BEGIN

	IF refEnv.Temp.Variable.IsErrorValidCampo IS TRUE THEN 
	ELSE 	
		CALL copyHttpHeadersFromInput(refIn, refOut);	
		
		CREATE LASTCHILD OF refOut DOMAIN getDOMINIO_JSON();
		CREATE LASTCHILD OF refOut.JSON NAME getDATA();
		DECLARE refJsonOutAudit REFERENCE TO refOut.JSON.Data;
		IF EXISTS(refEnv.DFDLOut.DFDL.{C_NOMBRE_PCML}.[]) OR EXISTS(refIn.JSON.Data.[]) THEN
			SET refOut = refIn;
		ELSEIF EXISTS(refEnv.StatusRes.JSON.[]) THEN
			SET refJsonOutAudit = refEnv.StatusRes.JSON.Data;
		ELSE
			SET refJsonOutAudit = refEnv.StatusRes.status;
		END IF;

		--Auditoria
		IF refEnv.StatusResp.exception IS FALSE THEN
        	CALL prepararMensajeAuditoriaV2(refEnv, getCONST_BACKEND(), getCONST_RESPONSE(), getSTATUS_INFO());
    	ELSE
        	CALL prepararMensajeAuditoriaV2(refEnv, getCONST_BACKEND(), getCONST_ERROR(), getSTATUS_ERROR());
    	END IF;

		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
		DELETE FIELD refOut.JSON;
	END IF;

		IF refIn.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '200' THEN 
			SET refEnv.Temp.Variable.IsErrorFuncional = TRUE;				
		END IF;

	DECLARE refError REFERENCE TO refEnv.DFDLOut.DFDL.{C_NOMBRE_PCML};
	
	IF EXISTS(refError.[<].PERROR[]) THEN
	
	    DECLARE mensaje CHARACTER;
	
	    SET mensaje = TRIM(
	                     LEADING '0'
	                     FROM CAST(refError.[<].PEMNSG AS CHARACTER CCSID 37)
	                  );
	                  
	    -- Simular estructura antigua
	    SET refError.[<].ERRNUM = refError.[<].PECODE;
	
	    SET refError.[<].ERNU01 = refError.[<].PERROR;
	
	    SET refError.[<].ERDS01 = mensaje;
	
	END IF;
		
	IF EXISTS(refEnv.Temp.SrvErrors.[]) THEN
		CALL FormatServiceErrorsForEnvironment(refEnv, refEnv.Temp.SrvErrors);
		CALL prepararBodyRespuestaErrorBus_HTTPV2(refEnv, refIn, refOut, C_OPERATION_RQ);
	ELSE
		CALL prepararBodyRespuestaBus_IBS_V2(refEnv, refIn, C_NOMBRE_PCML, refOut, C_OPERATION_RQ);
	END IF;
END;
