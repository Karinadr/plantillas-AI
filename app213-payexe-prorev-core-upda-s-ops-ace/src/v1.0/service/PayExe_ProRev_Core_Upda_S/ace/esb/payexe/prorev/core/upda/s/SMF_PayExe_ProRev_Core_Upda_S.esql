BROKER SCHEMA ace.esb.payexe.prorev.core.upda.s
PATH ace.esb.core.common;


CREATE COMPUTE MODULE SMF_PayExe_ProRev_Core_Upda_PrepInvocacion
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE refEnv REFERENCE TO Environment;
		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refLocalEnv REFERENCE TO InputLocalEnvironment;
		DECLARE refOutput REFERENCE TO OutputRoot;
		DECLARE refOutLocal REFERENCE TO OutputLocalEnvironment;

	    SET refEnv.StatusResp.exception = FALSE;
		CALL armaMensajeTo_AS400_From_UpdatePaymentExecutionProcedureReverseCore(refEnv, refIn, refLocalEnv, refOutput, refOutLocal);

		--Auditoria
		CALL prepararMensajeAuditoriaV2(refEnv, getCONST_BACKEND(), getCONST_REQUEST(), getSTATUS_INFO());
		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
	END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayExe_ProRev_Core_Upda_PrepRespSrv
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refOutput REFERENCE TO OutputRoot;
		DECLARE refEnv REFERENCE TO Environment;
		DECLARE refHeader REFERENCE TO refIn.HTTPResponseHeader;

		DECLARE httpStatusCode INTEGER COALESCE(refHeader."X-Original-HTTP-Status-Code", -1);
		DECLARE statusCode CHARACTER getCARACTER_VACIO();
		DECLARE hasException BOOLEAN COALESCE(refEnv.StatusResp.exception, FALSE);
		DECLARE isOkResponse BOOLEAN NOT hasException AND httpStatusCode = 200;

		IF NOT hasException THEN
			CALL convertCharToDfdlV2(refIn, refEnv);

			DECLARE refDfdlErr REFERENCE TO refEnv.DFDLOut.DFDL.{C_NOMBRE_PCML}.ELEERR;
			SET statusCode = getErrorCode(refDfdlErr.PECODE);
		END IF;

		IF isOkResponse AND statusCode = getCOD_EXITO() THEN
			SET refOutput = refIn;

			--Auditoria
			CALL prepararMensajeAuditoriaV2(refEnv, getCONST_BACKEND(), getCONST_RESPONSE(), getSTATUS_INFO());
			PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;

			CALL armaRptaUpdatePaymentExecutionProcedureReverseCore_OK(refEnv, refIn, refOutput);
		ELSE
			DECLARE refDestMain REFERENCE TO refEnv.Policy.service.destinations.Item[C_DESTINO_MAIN];

			IF hasException AND httpStatusCode > 0 THEN
				CALL AppendToServiceErrors(refIn, refEnv.Temp.SrvErrors, refDestMain.srv_info);
			END IF;

			CALL armaRptaUpdatePaymentExecutionProcedureReverseCore_ERROR(refEnv, refIn, refOutput, statusCode);
		END IF;

		--Auditoria
		CALL prepararRespuestaAuditoria(refEnv);	
	END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayExe_ProRev_Core_Upda_ControlarError
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refOutput REFERENCE TO OutputRoot;
		DECLARE refEnv REFERENCE TO Environment;
		CREATE FIELD refEnv.Variables;

		IF refEnv.Temp.Variable.IsErrorValidCampo = TRUE THEN
			CALL crearResponseStatus(refEnv, getTIP_RSPTA_2(), getCOD_ERROR_202(), getMSJ_ERROR(getCOD_ERROR_202()), '01', obtenerMensajeError(InputExceptionList));
		ELSE
			CREATE FIELD refEnv.StatusRes;
			CALL obtenerCodMsjErrorREST(InputExceptionList, refEnv.StatusRes, refIn, refEnv.Variables);
		END IF;

		CALL manejoErroresGenericoV2(InputExceptionList, refEnv.Variables);

		SET refOutput = refIn;
		SET refEnv.StatusResp.exception = TRUE;

	END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayExe_ProRev_Core_Upda_ControlarException
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        DECLARE refIn REFERENCE TO InputRoot;
        DECLARE refOutput REFERENCE TO OutputRoot;
        DECLARE refEnv REFERENCE TO Environment;
        CREATE FIELD refEnv.Variables;

        IF refEnv.Temp.Variable.IsErrorValidCampo = TRUE THEN
            CALL crearResponseStatus(refEnv, getTIP_RSPTA_2(), getCOD_ERROR_202(), getMSJ_ERROR(getCOD_ERROR_202()), '01', obtenerMensajeError(InputExceptionList));
        ELSE
            CREATE FIELD refEnv.StatusRes;
            CALL obtenerCodMsjErrorREST(InputExceptionList, refEnv.StatusRes, refIn, refEnv.Variables);
        END IF;

        CALL manejoErroresGenericoV2(InputExceptionList, refEnv.Variables);

        --Auditoria
        CALL prepararMensajeAuditoriaV2(refEnv, getCONST_MAIN(), getCONST_ERROR(), getSTATUS_ERROR());
        PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
    END;
END MODULE;

