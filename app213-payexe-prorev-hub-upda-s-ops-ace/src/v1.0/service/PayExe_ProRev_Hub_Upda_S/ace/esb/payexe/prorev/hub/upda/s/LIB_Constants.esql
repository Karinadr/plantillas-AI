DECLARE C_MAX_CANTIDAD_PAGOS    CONSTANT INTEGER 99999;

DECLARE C_COD_REPLACE CONSTANT CHARACTER '$1';
DECLARE C_ERROR_MSG_LONGITUD_DECIMAL CONSTANT CHARACTER 'La longitud del campo $1 debe ser 13 enteros y 2 decimales.';

