DECLARE C_OPERATION_RS CONSTANT CHARACTER 'UpdatePaymentExecutionProcedureReverseHubResponse';

DECLARE C_SC_ERROR_VALID CONSTANT CHARACTER '-1';

-- Wrapper del request hacia HUB SOAP.
DECLARE C_OPERATION_RQ_BK_1 CONSTANT CHARACTER 'C_OPERATION_RQ_BK_1';

-- ============ Nombres de campos BACKEND HUB (SOAP) ============
DECLARE C_BK_COD_RECAUDADOR     CONSTANT CHARACTER 'cod_recaudador';
