BROKER SCHEMA ace.esb.payinfass.agrdeblis.retr.b
PATH ace.esb.core.common;


CREATE COMPUTE MODULE SMF_PayInfAss_AgrDebLis_Retr_B_PrepInvoke
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE refEnv REFERENCE TO Environment;
		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refLocalEnv REFERENCE TO InputLocalEnvironment;
		DECLARE refOut REFERENCE TO OutputRoot;
		DECLARE refOutLocal REFERENCE TO OutputLocalEnvironment;

		SET refEnv.Temp.Variable.IsErrorValidCampo = FALSE;
		SET refEnv.StatusResp.exception = FALSE;
		SET refEnv.Temp.Variable.IsErrorFuncional = FALSE;
		SET refEnv.Temp.Variable.ConsultoTipoRec = FALSE;

		CREATE LASTCHILD OF refEnv.Temp IDENTITY(JSON.Array)SrvErrors;

		DECLARE refBodyIn REFERENCE TO refIn.JSON.Data.{C_OPERATION_RQ};

		SET refEnv.Srv.Destino = C_DESTINO_TIPO_REC;
		
		SET refEnv.Temp.Variable.ConsultoTipoRec = TRUE;
		CALL armaMensajeTo_BackendTipoRec(refEnv, refIn, refOut, refOutLocal);
		CALL prepararMensajeAuditoriaV2(refEnv, getCONST_BACKEND(), getCONST_REQUEST(), getSTATUS_INFO());
		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
		PROPAGATE TO TERMINAL 0 DELETE NONE;	
		
		DELETE FIELD refOut.JSON;
		
		IF refEnv.RESP.HTTPResponseHeader."X-Original-HTTP-Status-Code" = 200 THEN
			DECLARE respBackendTipoRec REFERENCE TO refEnv.RESP.JSON.Data.[<].CollectionServiceTypes;
			IF respBackendTipoRec.Item[1].OrganisationType = 'HUB' THEN
				SET refEnv.Srv.Destino = C_DESTINO_HUB;
				CALL armaMensajeTo_BackendHUB(refEnv, refIn, refOut, refOutLocal);
			ELSE
				SET refEnv.Srv.Destino = C_DESTINO_IBS;
				CALL armaCuerpo_BackendIBS(refEnv, refIn, refOut, refOutLocal);
			END IF;
			
			CALL prepararMensajeAuditoriaV2(refEnv, getCONST_BACKEND(), getCONST_REQUEST(), getSTATUS_INFO());
			PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
			PROPAGATE TO TERMINAL 0 DELETE NONE;
		END IF;
	
		PROPAGATE TO TERMINAL 1 DELETE NONE;
		RETURN FALSE;
		END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayInfAss_AgrDebLis_Retr_B_ReciveRespTipoRec
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refEnv REFERENCE TO Environment;
		DECLARE refOut REFERENCE TO OutputRoot;

		SET refEnv.RESP = refIn;

		DECLARE refData REFERENCE TO refIn.JSON.Data.{C_OPER_RQ_TIPO_REC};
		IF EXISTS(refData.OrganisationType[]) THEN
			SET refEnv.Temp.Variable.TipoRecaudacion = refData.OrganisationType;
		END IF;

		PROPAGATE TO TERMINAL 0 DELETE NONE;
		RETURN FALSE;
	END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayInfAss_AgrDebLis_Retr_B_DecideDestino
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE refEnv REFERENCE TO Environment;
		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refOut REFERENCE TO OutputRoot;
		DECLARE refOutLocal REFERENCE TO OutputLocalEnvironment;

		DECLARE chTipoRec CHARACTER refEnv.Temp.Variable.TipoRecaudacion;

		IF chTipoRec = C_TIPO_HUB THEN
			CALL armaMensajeTo_BackendHUB(refEnv, refIn, refOut, refOutLocal);
		ELSEIF chTipoRec = C_TIPO_CRL THEN
			SET refEnv.Temp.Variable.IsErrorFuncional = TRUE;
			SET refEnv.Variables.org.Error.Message = 'Tipo de recaudacion CRL no soportado';
			PROPAGATE TO TERMINAL 1 DELETE NONE;
			RETURN FALSE;
		ELSE
			CALL armaMensajeTo_BackendIBS(refEnv, refIn, refOut, refOutLocal);
		END IF;

		CALL prepararMensajeAuditoriaV2(refEnv, getCONST_BACKEND(), getCONST_REQUEST(), getSTATUS_INFO());
		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
		PROPAGATE TO TERMINAL 0 DELETE NONE;
		RETURN FALSE;
	END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayInfAss_AgrDebLis_Retr_B_ReciveResp
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refEnv REFERENCE TO Environment;
		DECLARE refOut REFERENCE TO OutputRoot;

		IF CONTAINS(UPPER(refIn.HTTPResponseHeader."Content-Type"), getDOMINIO_JSON()) OR CONTAINS(UPPER(refIn.HTTPResponseHeader."content-type"), getDOMINIO_JSON()) THEN
			SET refOut = refIn;
			DELETE FIELD refOut.BLOB;
			CREATE LASTCHILD OF refOut DOMAIN getDOMINIO_JSON() PARSE (refIn.BLOB.BLOB CCSID refIn.Properties.CodedCharSetId);

			SET refEnv.RESP = refOut;
			SET refEnv.StatusRes.status.srvResponseCode = refOut.HTTPResponseHeader."X-Original-HTTP-Status-Code";
			IF refEnv.StatusRes.status.srvResponseCode = 200 THEN
				SET refEnv.StatusRes.status.busResponseCode = C_CODE_01;
			ELSE
				SET refEnv.StatusRes.status.busResponseCode = C_CODE_02;
			END IF;
		ELSE
			SET refEnv.RESP = refIn;
			CREATE LASTCHILD OF refOut DOMAIN getDOMINIO_JSON();
		END IF;

		CALL prepararMensajeAuditoriaV2(refEnv, getCONST_BACKEND(), getCONST_RESPONSE(), getSTATUS_INFO());
		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
		DELETE FIELD refOut;

		PROPAGATE TO TERMINAL 0 DELETE NONE;
		RETURN FALSE;
	END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayInfAss_AgrDebLis_Retr_B_PrepRespSrv
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE refOut REFERENCE TO OutputRoot;
		DECLARE refEnv REFERENCE TO Environment;
		DECLARE refIn REFERENCE TO refEnv.RESP;
		DECLARE refHeader REFERENCE TO refIn.HTTPResponseHeader;
		DECLARE statusCode INTEGER COALESCE(refHeader."X-Original-HTTP-Status-Code", 0);
		DECLARE isViaHttp BOOLEAN statusCode > 0;
		DECLARE isOkResponse BOOLEAN NOT refEnv.StatusResp.exception AND statusCode = 200;

		IF isOkResponse THEN
			CALL armaRptaRetrieveAgreementDebtList_OK(refEnv, refIn, refOut);
		ELSE
			IF isViaHttp THEN
				DECLARE refDestBkd REFERENCE TO refEnv.Policy.service.destinations.Item[refEnv.Srv.Destino];
				CALL HandleHttpServiceError(
					refEnv,
			        refIn,
			        refDestBkd.srv_info,
			        refEnv.Temp.SrvErrors,
			        refEnv.Variables.org.Error.Message,
			        refEnv.Temp.Variable.IsErrorFuncional
				);
		    END IF;

			CALL armaRptaRetrieveAgreementDebtList_ERROR(refEnv, refIn, refOut);
		END IF;

		CALL prepareRespAudit(refEnv, refOut);
	END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayInfAss_AgrDebLis_Retr_B_ControlException
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        DECLARE refIn REFERENCE TO InputRoot;
        DECLARE refOutput REFERENCE TO OutputRoot;
        DECLARE refEnv REFERENCE TO Environment;

        SET refEnv.StatusResp.exception = TRUE;

        CREATE FIELD refEnv.StatusRes;
        
		CALL obtenerCodMsjErrorJSON(InputExceptionList, refEnv.StatusRes, refIn, refEnv.Variables);
		
        IF NOT EXISTS(refEnv.Variables.org.Error[]) THEN
        	SET refEnv.RESP.HTTPResponseHeader = refIn.HTTPResponseHeader;
        	CREATE FIELD refEnv.Variables.org.Error;
			DECLARE refError REFERENCE TO refEnv.Variables.org.Error;

        	IF IsEmptyEsp(refEnv.StatusRes.detalleError) THEN
        		DELETE FIELD refEnv.RESP.BLOB;
        		SET refError.Message = refEnv.StatusRes.JSON.Data.extensions.[<].Messages.Item[1].Message;
        	ELSE
				SET refError.Message = refEnv.StatusRes.detalleError;
        	END IF;
        END IF;
    END;
END MODULE;


CREATE COMPUTE MODULE SMF_PayInfAss_AgrDebLis_Retr_B_ControlError
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refOut REFERENCE TO OutputRoot;
		DECLARE refEnv REFERENCE TO Environment;
		CREATE FIELD refEnv.Variables;

		SET refEnv.StatusResp.exception = TRUE;

		IF IsNotEmptyEsp(refIn.JSON.Data.errorMessage) THEN
			SET refEnv.Variables.org.Error.Message = refIn.JSON.Data.errorMessage || C_GUION_SPACE || refIn.JSON.Data.errorDetails;
			SET refEnv.StatusRes.status.srvResponseCode = 500;
			SET refEnv.StatusRes.status.busResponseCode = C_CODE_02;
		ELSE
			CALL manejoErroresGenericoV2(InputExceptionList, refEnv.Variables);
		END IF;

		CREATE LASTCHILD OF refOut DOMAIN getDOMINIO_JSON();
		SET refOut.JSON.Data.Detail = refEnv.Variables.org.Error.Message;

		CALL prepararMensajeAuditoriaV2(refEnv, getCONST_MAIN(), getDETAIL(), getSTATUS_ERROR());
		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
		DELETE FIELD refOut.JSON;

		CALL FormatServiceErrorsForEnvironment(refEnv, refEnv.Temp.SrvErrors);
		CALL prepararBodyRespuestaErrorBus_HTTPV2(refEnv, refIn, refOut, C_OPERATION_RQ);

		CALL prepararMensajeAuditoriaV2(refEnv, getCONST_MAIN(), getCONST_ERROR(), getSTATUS_ERROR());
		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
	END;
END MODULE;
