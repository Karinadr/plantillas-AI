{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "RetrievePaymentInformationAssociationAgreementDebtList": {
      "type": "object",
      "properties": {
        "AgreementIdentification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9]+$",
          "description": "Código del convenio entre el banco y la empresa de servicios."
        },
        "TransactionIdentification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-zA-Z0-9\\-]+$",
          "description": "Identificador de la Transacción."
        },
        "TransactionDate": {
          "type": "string",
          "minLength": 14,
          "maxLength": 14,
          "pattern": "^\\d{4}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])([01]\\d|2[0-3])([0-5]\\d)([0-5]\\d)$",
          "description": "Fecha/hora de la transacción en sistema de origen (yyyyMMddHHmmss)."
        },
        "TransactionDateParam": {
          "type": "string",
          "minLength": 14,
          "maxLength": 14,
          "pattern": "^\\d{4}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])([01]\\d|2[0-3])([0-5]\\d)([0-5]\\d)$",
          "description": "Encabezado auxiliar que replica la marca de tiempo real para compatibilidad con el adaptador."
        },
        "ChannelIdentification": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9\\-\\_]+$",
          "description": "Código identificador del canal en sistema."
        },
        "NumberOfPage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999999,
          "description": "Número de página solicitada para paginación."
        },
        "TotalNumberOfRecords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999999,
          "description": "Número de la cantidad de registros máximo a entregar en la consulta."
        },
        "SourceSystemReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9]+$",
          "description": "Sistema Emisor, quien lo invoca."
        },
        "TargetSystemReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9]+$",
          "description": "Sistema Destino / Final."
        },
        "CollectionServiceConsumerReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9]+$",
          "description": "Números de referencia utilizados para identificar la deuda a consultar. (Nro de suministro)."
        },
        "PartyRoleReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z]+$",
          "description": "Código del recaudador registrado en el sistema."
        },
        "OriginTransactionIdentification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9]+$",
          "description": "Identificador de la transacción en el sistema que origina la solicitud, necesario para auditoría."
        },
        "CustomerReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9]+$",
          "description": "Identificador del cliente a consultar."
        },
        "AdditionalInformation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50,
                "pattern": "^[a-zA-Z0-9\\-\\_]+$"
              },
              "Value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50,
                "pattern": "^[a-zA-Z0-9\\-\\_]+$"
              }
            },
            "required": ["Name", "Value"]
          },
          "description": "Arreglo de objetos que contiene información adicional en formato de nombre y valor."
        }
      },
      "required": [
        "AgreementIdentification",
        "TransactionDateParam",
        "CollectionServiceConsumerReference",
        "PartyRoleReference",
        "OriginTransactionIdentification"
      ]
    }
  },
  "required": [
    "RetrievePaymentInformationAssociationAgreementDebtList"
  ]
}