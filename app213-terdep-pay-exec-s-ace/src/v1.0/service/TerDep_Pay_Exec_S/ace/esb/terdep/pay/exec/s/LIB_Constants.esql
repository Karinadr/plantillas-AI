BROKER SCHEMA ace.esb.terdep.pay.exec.s


--DESTINOS
DECLARE C_DESTINO_1 CONSTANT INTEGER '1';
DECLARE C_DESTINO_2 CONSTANT INTEGER '2';


--OTROS
DECLARE C_PLP_SERVICE CONSTANT CHARACTER 'PLP_TerDep_Pay_Exec_S';
DECLARE C_PL_USER_DEF CONSTANT CHARACTER 'PL_UserDefined';
DECLARE C_PROPERTIES CONSTANT CHARACTER 'Properties';
DECLARE C_POLICY_ID CHARACTER '{'||C_PLP_SERVICE||'}:'||C_PL_USER_DEF;
DECLARE C_NOMBRE_PCML CONSTANT CHARACTER 'DL0744RI';


--DOMINIOS
DECLARE C_HTTP_RH CONSTANT CHARACTER 'HTTPRequestHeader';
DECLARE C_HTTP_RES_H CONSTANT CHARACTER 'HTTPResponseHeader';


--SERVICIO
DECLARE C_DATA CONSTANT CHARACTER 'Data';
DECLARE C_I CONSTANT CHARACTER 'I';

DECLARE C_OPERATION_RQ CONSTANT CHARACTER 'ExecuteTermDepositPayments';
DECLARE C_OPERATION_RS CONSTANT CHARACTER 'ExecuteTermDepositPaymentsResponse';

DECLARE C_SC_ERROR_VALID CONSTANT CHARACTER '-1';


--VALIDACIONES
DECLARE C_ERROR_MSG_BDY_SERVICE_CODE CONSTANT CHARACTER 'El valor ingresado para el campo ServiceType no se encuentra registrado.';
DECLARE C_ERROR_MSG_LONGITUD_INVALIDA_BRANCHCODE CONSTANT CHARACTER 'La longitud del header Branch-Code debe estar en el rango [5,30].';
DECLARE C_ERROR_MSG_LONGITUD_INVALIDA_COUNTRYCODE CONSTANT CHARACTER 'La longitud del header Country-Code debe estar en el rango [5,30].';
DECLARE C_ERROR_MSG_LONGITUD_INVALIDA_USERID CONSTANT CHARACTER 'La longitud del header User-Id no debe exceder de 10.';
DECLARE C_ERROR_MSG_LONGITUD_INVALIDA_DEVICEID CONSTANT CHARACTER 'La longitud del header Device-Id debe estar en el rango [5,30].';

DECLARE C_ERROR_MSG_DECIMALES_INVALIDOS_DEPOSITAMOUNT CONSTANT CHARACTER 'El valor ingresado para el campo DepositAmount no esta dentro del rango valido.';

--SENSITIVE DATA
DECLARE C_PERSONIDENTIFICATION CONSTANT CHARACTER 'PersonIdentification';
