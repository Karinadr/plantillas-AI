BROKER SCHEMA ace.esb.terdep.pay.exec.s
PATH ace.esb.core.common;


CREATE COMPUTE MODULE SMF_TerDep_Pay_Exec_PrepInvocacion
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		DECLARE refEnv REFERENCE TO Environment;
		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refLocalEnv REFERENCE TO InputLocalEnvironment;
		DECLARE refOutput REFERENCE TO OutputRoot;
		DECLARE refOutLocal REFERENCE TO OutputLocalEnvironment;

		-- Eliminar RequestSchema
		DELETE FIELD refOutput.JSON.Data;

		-- Decrypt
		CALL armaCuerpo_Decrypt(refIn, refEnv);
		IF EXISTS(refEnv.RequestGenericDecrypt.ValueList.ValueItem[]) THEN
			PROPAGATE TO LABEL getLBL_DECRYPT() DELETE NONE;

			IF refEnv.Cipher.Decrypt.StatusRes.exception = TRUE THEN
				RETURN FALSE;
			END IF;
		END IF;

		SET refEnv.StatusResp.exception = FALSE;
		CALL armaMensajeTo_AS400_From_ExecuteTermDepositPayments(refEnv, refIn, refLocalEnv, refOutput, refOutLocal);

		--Auditoria
		CALL prepararMensajeAuditoria(refEnv, getCONST_BACKEND(), getCONST_REQUEST());
		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;

	END;
END MODULE;


CREATE COMPUTE MODULE SMF_TerDep_Pay_Exec_PrepRespSrv
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refOutput REFERENCE TO OutputRoot;
		DECLARE refEnv REFERENCE TO Environment;
		DECLARE statusCode INTEGER COALESCE(SUBSTRING(refEnv.DFDLOut.OutputError FROM 1 FOR 2), 0);
		CALL convertCharToDfdl(refIn, refEnv);

		IF refEnv.StatusResp.exception IS FALSE AND statusCode = 0 THEN
			SET refOutput = refIn;
			--Auditoria
			CALL prepararMensajeAuditoria(refEnv, getCONST_BACKEND(), getCONST_RESPONSE());
			PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;
			
			CALL armaRptaExecuteTermDepositPayments_OK(refEnv, refIn, refOutput);
		ELSE
			CALL armaRptaExecuteTermDepositPayments_ERROR(refEnv, refIn, refOutput, statusCode);

		END IF;

		--Auditoria
		IF refEnv.Temp.Variable.IsErrorValidCampo IS TRUE THEN 
			CALL prepararMensajeAuditoria(refEnv, getCONST_MAIN(), getCONST_ERROR());
		ELSE 
			CALL prepararMensajeAuditoria(refEnv, getCONST_MAIN(), getCONST_RESPONSE());
		END IF;
		PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;

	END;
END MODULE;


CREATE COMPUTE MODULE SMF_TerDep_Pay_Exec_ControlarError
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		DECLARE refIn REFERENCE TO InputRoot;
		DECLARE refOutput REFERENCE TO OutputRoot;
		DECLARE refEnv REFERENCE TO Environment;
		CREATE FIELD refEnv.Variables;

		IF refEnv.Temp.Variable.IsErrorValidCampo = TRUE THEN
			CALL crearResponseStatus(refEnv, getTIP_RSPTA_2(), getCOD_ERROR_202(), getMSJ_ERROR(getCOD_ERROR_202()), '01', obtenerMensajeError(InputExceptionList));
		ELSE
			CREATE FIELD refEnv.StatusRes;
			CALL ObtenerCodMsjErrorTCPIP(InputExceptionList, refEnv.StatusRes, refEnv.Variables);
		END IF;

		CALL manejoErroresGenerico(InputExceptionList, refEnv.Variables);

		SET refOutput = refIn;
		SET refEnv.StatusResp.exception = TRUE;

	END;
END MODULE;


CREATE COMPUTE MODULE SMF_TerDep_Pay_Exec_ControlarException
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN

        DECLARE refIn REFERENCE TO InputRoot;
        DECLARE refOutput REFERENCE TO OutputRoot;
        DECLARE refEnv REFERENCE TO Environment;
        CREATE FIELD refEnv.Variables;

        IF refEnv.Temp.Variable.IsErrorValidCampo = TRUE THEN
            CALL crearResponseStatus(refEnv, getTIP_RSPTA_2(), getCOD_ERROR_202(), getMSJ_ERROR(getCOD_ERROR_202()), '01', obtenerMensajeError(InputExceptionList));
        ELSE
            CREATE FIELD refEnv.StatusRes;
            CALL ObtenerCodMsjErrorTCPIP(InputExceptionList, refEnv.StatusRes, refEnv.Variables);
        END IF;

        CALL manejoErroresGenerico(InputExceptionList, refEnv.Variables);

        CALL prepararBodyRespuestaBus_IBS_(refEnv, refIn, C_NOMBRE_PCML, refOutput, C_OPERATION_RS);

        --Auditoria
        CALL prepararMensajeAuditoria(refEnv, getCONST_MAIN(), getCONST_ERROR());
        PROPAGATE TO LABEL getLBL_AUDIT() DELETE NONE;

    END;
END MODULE;

