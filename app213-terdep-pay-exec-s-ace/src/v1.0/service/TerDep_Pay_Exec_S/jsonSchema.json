{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ExecuteTermDepositPayments",
  "type": "object",
  "properties": {
    "ExecuteTermDepositPayments": {
      "type": "object",
      "properties": {
        "ServiceType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]+$",
          "description": "Codigo unico de catalogo para invocar al servicio"
        },
        "PaymentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
      	  "pattern": "^[A-Z0-9]+$",
          "description": "Tipo Transferencia  A=Alta"
        },
        "TermDepositNumber": {
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
		  "pattern": "^[0-9]+$",
          "description": "Nro. De Deposito"
        },
		"AccountNumber": {
          "type": "string",
          "minLength": 12,
          "maxLength": 12,
		  "pattern": "^[0-9]+$",
          "description": "Nro. De Cuenta"
        },
		"DepositAmount": {
          "type": "number",
          "description": "Monto del deposito",
          "minimum": 1,
          "example": 9999999.99
        },
		"CurrencyCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
      	  "enum": ["SOL", "USD"],
          "description": "Tipo Moneda"
        },
		"MemberIdentification": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
		  "pattern": "^[A-Z0-9]+$",
          "description": "IdUsuario Canal"
        }
      },
      "required": [
        "ServiceType",
        "PaymentType",
        "TermDepositNumber",
        "AccountNumber",
		"DepositAmount",
		"CurrencyCode",
		"MemberIdentification"
      ]
    }
  },
  "required": [
    "ExecuteTermDepositPayments"
  ]
}
